{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/learn/excel", "destination": "/learn-excel.html" },
    { "source": "/learn/excel/(.*)", "destination": "/learn-excel.html" },
    { "source": "/webinar", "destination": "/webinar.html" },
    { "source": "/webinar/", "destination": "/webinar.html" },
    { "source": "/webinar-dashboard", "destination": "/webinar-dashboard.html" },
    { "source": "/roadmaps", "destination": "/roadmaps.html" },
    { "source": "/roadmaps/", "destination": "/roadmaps.html" },
    { "source": "/roadmap", "destination": "/roadmaps.html" },
    { "source": "/data-warriors/admin", "destination": "/data-warriors-admin.html" },
    { "source": "/data-warriors/admin/", "destination": "/data-warriors-admin.html" },
    { "source": "/data-warriors", "destination": "/data-warriors.html" },
    { "source": "/data-warriors/", "destination": "/data-warriors.html" },
    { "source": "/data-warriors/(.*)", "destination": "/data-warriors.html" },
    { "source": "/quizzes", "destination": "/quizzes.html" },
    { "source": "/quizzes/", "destination": "/quizzes.html" },
    { "source": "/quizzes/dashboard", "destination": "/quizzes.html" },
    { "source": "/quizzes/dashboard/", "destination": "/quizzes.html" },
    { "source": "/quizzes/play", "destination": "/quizzes-play.html" },
    { "source": "/quizzes/join", "destination": "/quizzes-play.html" },
    { "source": "/u/:username", "destination": "/api/profile?u=:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
